-- seed-two-tenants.sql.template
-- Adapt to your schema. The point: NEVER verify isolation with one tenant.
-- With a single tenant, every query "passes" even with no tenant filter at all.
--
-- Create two tenants and a row of data in each, owned by different users.
-- Then in the app, log in as User B and confirm Tenant A's row is invisible.

INSERT INTO tenants (id, name) VALUES
  ('11111111-1111-1111-1111-111111111111', 'Tenant A'),
  ('22222222-2222-2222-2222-222222222222', 'Tenant B');

INSERT INTO users (id, email, tenant_id) VALUES
  ('aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', 'user-a@example.com', '11111111-1111-1111-1111-111111111111'),
  ('bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb', 'user-b@example.com', '22222222-2222-2222-2222-222222222222');

-- One clearly-labeled secret per tenant. If User B can ever see "SECRET-A",
-- you have a cross-tenant leak.
INSERT INTO documents (id, tenant_id, title, body) VALUES
  (gen_random_uuid(), '11111111-1111-1111-1111-111111111111', 'SECRET-A', 'Only Tenant A may see this'),
  (gen_random_uuid(), '22222222-2222-2222-2222-222222222222', 'SECRET-B', 'Only Tenant B may see this');
